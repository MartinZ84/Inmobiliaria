                                    <a class="nav-link text-white-50 py-1" asp-controller="Inmuebles" asp-action="Index"
                                        asp-route-estado="3"
                                        onclick="setActiveSubmenu(this, 'inmueblesToggle'); return true;">
                                        <i class="bi bi-x-circle"></i> Inmuebles dados de baja
