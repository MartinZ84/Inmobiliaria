<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inmobiliaria Z&VC asociados</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inmobiliaria.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/localization/messages_es.js"></script>


    <!-- CSS de Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- JS de Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        /* Estilos para el submenú colapsible */
        .submenu-arrow {
            transition: transform 0.3s ease;
            font-size: 0.8rem;
        }

        .submenu-arrow.rotated {
            transform: rotate(90deg);
        }

        .nav-link:hover .submenu-arrow {
            color: #fff !important;
        }

        /* Estilos para los elementos del submenú */
        .nav-item .nav-item .nav-link {
            font-size: 0.9rem;
            padding-left: 2rem !important;
        }

        .nav-item .nav-item .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 0.25rem;
        }

        /* Estilos para elementos activos/con foco */
        .nav-link.active {
            background-color: rgba(255, 255, 255, 0.2) !important;
            border-radius: 0.25rem;
            font-weight: bold;
        }

        .nav-item .nav-item .nav-link.active {
            background-color: rgba(255, 255, 255, 0.25) !important;
            color: #fff !important;
            font-weight: bold;
        }

        /* Efecto de enfoque para el menú padre cuando tiene submenú activo */
        .nav-link.parent-active {
            background-color: rgba(255, 255, 255, 0.1) !important;
            border-radius: 0.25rem;
        }
    </style>
</head>

<body>
