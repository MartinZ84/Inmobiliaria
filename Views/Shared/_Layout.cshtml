    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function toggleSubmenu(submenuId, toggleElement) {
            const submenu = document.getElementById(submenuId);
            const arrow = toggleElement.querySelector('.submenu-arrow');

            if (submenu.style.display === 'none' || submenu.style.display === '') {
                submenu.style.display = 'block';
                arrow.classList.add('rotated');
            } else {
                submenu.style.display = 'none';
                arrow.classList.remove('rotated');
            }
        }

        function setActiveMenu(element) {
            // Remover clase active de todos los enlaces principales
            document.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('active', 'parent-active');
            });

            // Agregar clase active al elemento clickeado
            element.classList.add('active');

            // Cerrar todos los submenús
            document.querySelectorAll('[id$="Submenu"]').forEach(submenu => {
                submenu.style.display = 'none';
            });
            document.querySelectorAll('.submenu-arrow').forEach(arrow => {
                arrow.classList.remove('rotated');
            });
        }

        function setActiveSubmenu(element, parentId) {
            // Remover clase active de todos los enlaces
            document.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('active', 'parent-active');
            });

            // Agregar clase active al submenú clickeado
            element.classList.add('active');

            // Agregar clase parent-active al menú padre
            const parentElement = document.getElementById(parentId);
            if (parentElement) {
                parentElement.classList.add('parent-active');
            }

            // Asegurar que el submenú permanezca abierto
            const submenu = document.getElementById('inmueblesSubmenu');
            const arrow = parentElement ? parentElement.querySelector('.submenu-arrow') : null;
            if (submenu && arrow) {
                submenu.style.display = 'block';
                arrow.classList.add('rotated');
            }

            // Guardar el estado en sessionStorage para mantenerlo después de la navegación
            sessionStorage.setItem('activeSubmenu', element.textContent.trim());
            sessionStorage.setItem('submenuOpen', 'true');
        }

        // Función para mantener el estado activo al cargar la página
        document.addEventListener('DOMContentLoaded', function () {
            const currentPath = window.location.pathname.toLowerCase();
            const urlParams = new URLSearchParams(window.location.search);

            // Si estamos en la página de inmuebles
            if (currentPath.includes('/inmuebles')) {
                const estado = urlParams.get('estado');

                // Activar el menú padre de inmuebles
                const parentToggle = document.getElementById('inmueblesToggle');
                if (parentToggle) {
                    parentToggle.classList.add('parent-active');
                }

                // Mostrar el submenú
                const submenu = document.getElementById('inmueblesSubmenu');
                const arrow = parentToggle ? parentToggle.querySelector('.submenu-arrow') : null;
                if (submenu && arrow) {
                    submenu.style.display = 'block';
                    arrow.classList.add('rotated');
                }

                // Activar el submenú correspondiente
                let activeSubmenuLink = null;
                if (estado === 'Disponible') {
                    activeSubmenuLink = submenu.querySelector('a[asp-route-estado="Disponible"]');
                } else if (estado === 'Baja') {
                    activeSubmenuLink = submenu.querySelector('a[asp-route-estado="Baja"]');
                } else {
                    // Para "Todos" (sin parámetro de estado)
                    activeSubmenuLink = submenu.querySelector('a:not([asp-route-estado])');
                }

                if (activeSubmenuLink) {
                    activeSubmenuLink.classList.add('active');
                }
            } else {
                // Para otros menús principales
                if (currentPath.includes('/home') || currentPath === '/') {
                    const homeLink = document.querySelector('a[asp-controller="Home"]');
                    if (homeLink) homeLink.classList.add('active');
                } else if (currentPath.includes('/propietarios')) {
                    const propLink = document.querySelector('a[asp-controller="Propietarios"]');
                    if (propLink) propLink.classList.add('active');
                } else if (currentPath.includes('/inquilinos')) {
                    const inquiLink = document.querySelector('a[asp-controller="Inquilinos"]');
                    if (inquiLink) inquiLink.classList.add('active');
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>