                @if (User.Identity.IsAuthenticated)
                {

                    @* <a class="btn btn-primary py-2 d-none d-md-inline-block float-right" asp-controller="Usuarios" asp-action="Login"><span class="lnr lnr-enter"></span> Acceder</a>
                      }
                      else{ *@
                    @* <a class="btn btn-primary py-2 d-none d-md-inline-block float-right" asp-controller="Usuarios" asp-action="Logout"><span class="lnr lnr-exit"></span> Salir</a> *@
                    <ul class="nav flex-column components">
