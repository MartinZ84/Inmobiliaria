                                <i class="bi bi-people"></i> Inquilinos
                            </a>
                        </li>

                        <!-- Menú de Inmuebles con submenú colapsible -->
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#" id="inmueblesToggle"
