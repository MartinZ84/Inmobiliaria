                                {
                                    <span> | <i class="bi bi-rulers"></i> @inmueble.Superficie m²</span>
                                }
                            </small>
                        </div>

                        <!-- Propietario -->
                        <p class="card-text">
                            <small class="text-muted">
                                <i class="bi bi-person"></i>
