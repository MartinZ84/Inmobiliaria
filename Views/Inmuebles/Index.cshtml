@model IEnumerable<Inmobiliaria.Models.Entidades.Inmueble>
@{
    ViewData["Title"] = "Inmuebles";
    var Pagina = ViewBag.Pagina ?? 1;
    var TotalPaginas = ViewBag.TotalPaginas ?? 1;
}

<h1 class="mt-4">Listado de Inmuebles</h1>
<hr />

@await Html.PartialAsync("_AutoDismissAlert")

<div class="row mb-3">
    <div class="col-md-10">
        <form method="get" asp-action="Index" id="formFiltros">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <button class="btn btn-link p-0 text-decoration-none" type="button" data-bs-toggle="collapse"
                            data-bs-target="#filtrosCollapse" aria-expanded="false" aria-controls="filtrosCollapse">
                            <i class="bi bi-funnel me-2"></i>Filtros de búsqueda
                            <i class="bi bi-chevron-down ms-1"></i>
                        </button>
                    </h6>
                </div>

                <div class="collapse show" id="filtrosCollapse">
                    <div class="card-body">
                        <div class="row g-3">
                            @* <div class="col-md-4"></div>
                                <label for="direccion" class="form-label">Dirección</label>
                                <input type="text" class="form-control" id="direccion" name="direccion"
                                    value="@ViewBag.Direccion" placeholder="Buscar por dirección">
                            </div> *@

                            <div class="col-md-2">
                                <label for="tipo" class="form-label">Tipo</label>
                                <select class="form-control" id="tipo" name="tipo" asp-items="ViewBag.Tipos">
                                    <option value="">Todos</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label for="uso" class="form-label">Uso</label>
                                <select class="form-control" id="uso" name="uso" asp-items="ViewBag.Usos">
                                    <option value="">Todos</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label for="estado" class="form-label">Estado</label>
                                <select class="form-control" id="estado" name="estado" asp-items="ViewBag.Estados">
                                    <option value="">Todos</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label for="precioMin" class="form-label">Precio Mín.</label>
                                <input type="number" class="form-control" id="precioMin" name="precioMin"
                                    value="@ViewBag.PrecioMin" placeholder="Desde">
                            </div>

                            <div class="col-md-2">
                                <label for="precioMax" class="form-label">Precio Máx.</label>
                                <input type="number" class="form-control" id="precioMax" name="precioMax"
                                    value="@ViewBag.PrecioMax" placeholder="Hasta">
                            </div>

                        </div>

                        <div class="row g-3">
                            <div class="col-md-4 ">
                                <label for="PropietarioId" class="form-label">Propietario</label>
                                <select id="PropietarioId" name="PropietarioId" class="form-control"
                                    style="width:100%" ></select>
                            </div>
                            <div class="col-md-3">
                                <label for="FechaDesde" class="form-label">Fecha Disponibilidad Inicio</label>
                                @if (ViewBag.FechaDesde != null)
                                {
                                    var fechaInicio = ViewBag.FechaDesde.ToString("yyyy-MM-dd");
                                    <input type="date" name="FechaDesde" id="FechaDesde" class="form-control"
                                        value=@fechaInicio />
                                }
                                else
                                {
                                    <input type="date" name="FechaDesde" id="FechaDesde" value="" min="" max=""
                                        class="form-control" />
                                }
                                <span for="FechaDesde" class="text-danger"></span>
                            </div>


                            <div class=" col-md-3">
                                <label for="fechaHasta" class="form-label">Fecha Disponibilidad Fin</label>
                                @if (ViewBag.FechaHasta != null)
                                {
                                    var fechaFin = ViewBag.FechaHasta.ToString("yyyy-MM-dd");
                                    <input type="date" name="fechaHasta" id="fechaHasta" class="form-control" value=@fechaFin />
                                }
                                else
                                {

                                    <input type="date" name="fechaHasta" id="fechaHasta" value="" class="form-control" />
                                }
                                <span for="fechaHasta" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <button type="submit" class="btn btn-outline-primary me-2">
                                    <i class="bi bi-search me-1"></i>Buscar
                                </button>
                                <button type="button" class="btn btn-outline-secondary me-2" id="btnLimpiar">
                                <i class="bi bi-eraser me-1"></i>Limpiar
                            </button>
                            @* <a href="@Url.Action("Disponibles")" class="btn btn-outline-success me-2">
                                    <i class="bi bi-check-circle me-1"></i>Solo Disponibles
                                </a> *@
                        </div>
                    </div>
                    </div>



                    
                </div>
            </div>

        </form>
    </div>

    <div class="col-md-2 d-flex align-items-start">
        <a asp-action="Create" class="btn btn-primary w-100">
            <i class="bi bi-plus-circle me-1"></i>Nuevo Inmueble
        </a>
    </div>
</div>

<!-- Cards de inmuebles -->
