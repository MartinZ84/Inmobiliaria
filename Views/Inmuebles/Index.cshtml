    @if (Model != null && Model.Any())
    {
        @foreach (var inmueble in Model)
        {
            @* <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(inmueble.PrimeraImagen) ? "/images/no-image.png" : inmueble.PrimeraImagen)"
                            class="card-img-top" alt="@inmueble.Direccion" style="height:200px; object-fit:cover;">

                        <span class="position-absolute top-0 end-0 m-2">
                            @if (inmueble.EstaDisponible)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No Disponible</span>
                            }
                        </span>
                        <span class="position-absolute top-0 start-0 m-2">
                            <span class="badge bg-primary">@inmueble.Tipo</span>
                        </span>
                        @if (inmueble.ListaImagenes.Count > 1)
                        {
                            <span class="position-absolute bottom-0 end-0 m-2">
                                <span class="badge bg-dark bg-opacity-75">
                                    <i class="bi bi-images"></i> @inmueble.ListaImagenes.Count
                                </span>
                            </span>
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <i class="bi bi-geo-alt text-danger"></i> @inmueble.Direccion
                        </h5>
                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="bi bi-house"></i> @inmueble.Uso |
                                <i class="bi bi-door-open"></i> @inmueble.Ambientes amb.
                                @if (inmueble.Superficie.HasValue)
                                {
                                    <span> | <i class="bi bi-rulers"></i> @inmueble.Superficie m²</span>
                                }
                            </small>
                        </div>
                        <p class="card-text">
                            <small class="text-muted">
                                <i class="bi bi-person"></i> @inmueble.Propietario?.Nombre @inmueble.Propietario?.Apellido
                            </small>
                        </p>
                        <div class="mt-auto">
                            <h4 class="text-success mb-3">
                                <i class="bi bi-currency-dollar"></i> @inmueble.Precio.ToString("N0")
                            </h4>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@inmueble.Id" class="btn btn-primary btn-sm flex-fill">
                                    <i class="bi bi-eye"></i> Ver Detalles
                                </a>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@inmueble.Id">
                                                <i class="bi bi-pencil text-success"></i> Editar
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Delete" asp-route-id="@inmueble.Id">
                                                <i class="bi bi-trash text-danger"></i> Eliminar
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div> *@
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <!-- Imagen del inmueble -->
                    <div class="position-relative">
                        <img src="@inmueble.PrimeraImagenDisplay" class="card-img-top" alt="@inmueble.Direccion"
                            style="height:200px; object-fit:cover;">

                        <!-- Badge de estado -->
                        <span class="position-absolute top-0 end-0 m-2">
                            @if (inmueble.EstadoNumero == 1)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else if (inmueble.EstadoNumero == 2)
                            {
                                <span class="badge bg-danger">No Disponible</span>
                            }
                            else if (inmueble.EstadoNumero == 3)
                            {
                                <span class="badge bg-secondary">Baja</span>
                            }

                        </span>

                        <!-- Badge de tipo -->
                        <span class="position-absolute top-0 start-0 m-2">
                            <span class="badge bg-primary">@inmueble.TipoInmueble?.Descripcion</span>
                        </span>

                        <!-- Indicador de múltiples imágenes -->
                        @if (inmueble.ListaImagenes != null && inmueble.ListaImagenes.Count > 1)
