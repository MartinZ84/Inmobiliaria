    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-house-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No se encontraron inmuebles</h4>
            <a asp-action="Create" class="btn btn-primary mt-3">
                <i class="bi bi-plus-circle me-1"></i>Registrar primer inmueble
            </a>
        </div>
    }
</div>
<!-- Paginación con persistencia de filtros -->
<nav aria-label="Page navigation">
    <ul class="pagination">
        <!-- Botón "Anterior" -->
        @if (Pagina > 1)
        {
            <li class="page-item">
                <a class="page-link"
                    href="~/Inmuebles/Index?pagina=@(Pagina - 1)&tipo=@ViewBag.Tipo&uso=@ViewBag.Uso&estado=@ViewBag.Estado&precioMin=@ViewBag.PrecioMin&precioMax=@ViewBag.PrecioMax"
                    aria-label="Anterior">
                    <i class="fa-solid fa-angles-left">Anterior</i>
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link"><i class="fa-solid fa-angles-left">Anterior</i></span>
            </li>
        }

        <!-- Números de página -->
        @for (int i = 1; i <= TotalPaginas; i++)
        {
            <li class="page-item @(i == Pagina ? "active" : "")">
                <a class="page-link"
                    href="~/Inmuebles/Index?pagina=@i&tipo=@ViewBag.Tipo&uso=@ViewBag.Uso&estado=@ViewBag.Estado&precioMin=@ViewBag.PrecioMin&precioMax=@ViewBag.PrecioMax">@i</a>
            </li>
        }

        <!-- Botón "Siguiente" -->
        @if (Pagina < TotalPaginas)
        {
            <li class="page-item">
                <a class="page-link"
                    href="~/Inmuebles/Index?pagina=@(Pagina + 1)&tipo=@ViewBag.Tipo&uso=@ViewBag.Uso&estado=@ViewBag.Estado&precioMin=@ViewBag.PrecioMin&precioMax=@ViewBag.PrecioMax"
                    aria-label="Siguiente">
                    <i class="fa-solid fa-angles-right">Siguiente</i>
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link"><i class="fa-solid fa-angles-right">Siguiente</i></span>
            </li>
        }
    </ul>
</nav>
<style>
  .select2-container .select2-selection--single {
      height: calc(2.25rem + 2px);
      padding: 0.375rem 0.75rem;
      font-size: 1rem;
      line-height: 1.5;
      color: #212529;
      background-color: #fff;
      border: 1px solid #ced4da;
      border-radius: 0.375rem;
  }
</style>
<script>
    $(document).ready(function () {
        // Botón limpiar filtros
        $('#btnLimpiar').click(function () {
            $('#direccion, #tipo, #uso, #estado, #precioMin, #precioMax').val('');
            window.location.href = '@Url.Action("Index", "Inmuebles")';
        });

        // Mostrar collapse si hay filtros activos
        @if (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                !string.IsNullOrEmpty(ViewBag.TipoSeleccionado?.ToString()) ||
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                !string.IsNullOrEmpty(ViewBag.UsoSeleccionado?.ToString()) ||
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                !string.IsNullOrEmpty(ViewBag.EstadoSeleccionado?.ToString()) ||
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ViewBag.PrecioMin != null || ViewBag.PrecioMax != null)
            {
                <text>
                    $('#filtrosCollapse').addClass('show');
                </text>
        }
});
</script>

<script>

function buscar(q) {
    return $.ajax({
        url: `@Url.Action("Buscar", "Inmuebles")/${q}`,
        method: "GET"
    }).done(res => {
        console.log("Búsqueda: ", res);
    }).fail(res => {
        console.log("Error: ", res);
    });
}


    $(document).ready(function () {
        $('#PropietarioId').select2({
            placeholder: "Buscar propietario...",
            minimumInputLength: 3, // busca a partir de 2 caracteres
            language: {
                errorLoading: () => 'No se pudieron cargar los resultados.',
                inputTooLong: args => {
                    const over = args.input.length - args.maximum;
                    return `Por favor, borre ${over} caracter${over > 1 ? 'es' : ''}`;
                },
                inputTooShort: args => {
                    const remaining = args.minimum - args.input.length;
                    return `Por favor, introduzca ${remaining} caracter${remaining > 1 ? 'es' : ''}`;
                },
                loadingMore: () => 'Cargando más resultados…',
                maximumSelected: args => `Sólo puede seleccionar ${args.maximum} elemento${args.maximum > 1 ? 's' : ''}`,
                noResults: () => 'No se encontraron resultados',
                searching: () => 'Buscando…',
                removeAllItems: () => 'Eliminar todos los elementos'
            },
            ajax: {
                url: '/Propietarios/Buscar',   // coincide con tu controller
                dataType: 'json',
                delay: 250, // retrasa un poco la búsqueda
                data: function (params) {
                    return {
                        q: params.term // lo que el usuario escribe
                    };
                },
                processResults: function (data) {
                    return {
                        results: data.datos.map(function (item) {
                            return {
                                id: item.id,  // lo que se guarda en el select
                                text: item.nombre + " " + item.apellido // lo que se muestra
                            };
                        })
                    };
                }
            }
        });
    });

    // Restaurar selección si viene desde el servidor
var propietarioId = '@ViewBag.PropietarioId';
var nombrePropietario = '@ViewBag.NombrePropietario';
var apellidoPropietario = '@ViewBag.ApellidoPropietario';
if (propietarioId) {
    $.ajax({
        type: 'GET',
        url: '/Propietarios/ObtenerPropPorId', // tu endpoint que devuelve {id,text}
        data: { id: propietarioId }
    }).then(function (data) {
        var option = new Option(data.text, data.id, true, true);
        $('#PropietarioId').append(option).trigger('change');
    });
}
</script>


