@model IEnumerable<Inmobiliaria.Models.Entidades.TipoInmueble>
@{
    ViewData["Title"] = "Tipo de Inmueble";
    var Pagina = ViewBag.Pagina ?? 1;
    var TotalPaginas = ViewBag.TotalPaginas ?? 1;
}

<h1 class="mt-4">Listado Tipos Inmueble</h1>
<hr />
    <div class="col-md-2 d-flex align-items-start mb-2">
        <a asp-action="Create" class="btn btn-primary w-100">
            <i class="bi bi-plus-circle me-1"></i>Nuevo
        </a>
    </div>

@await Html.PartialAsync("_AutoDismissAlert")

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="accionesMenu_@item.Id" data-bs-toggle="dropdown" aria-expanded="false" title="Acciones">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="accionesMenu_@item.Id">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Edit" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil text-success"></i>
                                            <span>Editar</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Delete" asp-route-id="@item.Id">
                                            <i class="bi bi-trash text-danger"></i>
                                            <span>Borrar</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
<nav aria-label="Page navigation">
    <ul class="pagination">
        <!-- Botón "Anterior" -->
        @if (Pagina > 1)
        {
            <li class="page-item">
                <a class="page-link" href="~/Inquilinos/Index?pagina=@(Pagina - 1)&dni=@ViewBag.Dni&nombre=@ViewBag.Nombre&apellido=@ViewBag.Apellido&email=@ViewBag.Email" aria-label="Anterior">
                    <i class="fa-solid fa-angles-left">Anterior</i>
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link"><i class="fa-solid fa-angles-left">Anterior</i></span>
            </li>
        }

        <!-- Números de página -->
        @for (int i = 1; i <= TotalPaginas; i++)
        {
            <li class="page-item @(i == Pagina ? "active" : "")">
                <a class="page-link" href="~/Inquilinos/Index?pagina=@i&dni=@ViewBag.Dni&nombre=@ViewBag.Nombre&apellido=@ViewBag.Apellido&email=@ViewBag.Email">@i</a>
            </li>
        }
        
        <!-- Botón "Siguiente" -->
        @if (Pagina < TotalPaginas)
        {
            <li class="page-item">
                <a class="page-link" href="~/Inquilinos/Index?pagina=@(Pagina + 1)&dni=@ViewBag.Dni&nombre=@ViewBag.Nombre&apellido=@ViewBag.Apellido&email=@ViewBag.Email" aria-label="Siguiente">
                    <i class="fa-solid fa-angles-right">Siguiente</i>
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link"><i class="fa-solid fa-angles-right">Siguiente</i></span>
            </li>
        }
    </ul>
</nav>
</div>