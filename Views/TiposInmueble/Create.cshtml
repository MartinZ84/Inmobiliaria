@model Inmobiliaria.Models.Entidades.TipoInmueble

@{
    ViewData["Title"] = "Nuevo Tipo de Inmueble";
}

<h4 class="mt-4">Nuevo Tipo</h4>
<hr />

@await Html.PartialAsync("_AutoDismissAlert")

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <!-- Información básica -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-house"></i> Información Básica</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Descripcion" class="control-label"></label>
                            <input asp-for="Descripcion" class="form-control" maxlength="100" placeholder="Tipo de inmueble" />
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group mb-4">
                <input type="submit" value="Crear Tipo" class="btn btn-primary me-2" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}