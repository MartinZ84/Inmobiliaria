@model IEnumerable<Inmobiliaria.Models.Entidades.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
}

<h1 class="mt-4">Listado de Inquilinos</h1>
<hr />

@await Html.PartialAsync("_AutoDismissAlert")

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dni)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Lugar_Trabajo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dni_Garante)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre_Garante)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido_Garante)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono_Garante)
            </th> *@
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
 
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Apellido)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Dni)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
         
            <td>
                <div class="dropdown">
                    <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="accionesMenu_@item.Id" data-bs-toggle="dropdown" aria-expanded="false" title="Acciones">
                        <i class="bi bi-three-dots"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="accionesMenu_@item.Id">
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Edit" asp-route-id="@item.Id">
                                <i class="bi bi-pencil text-success"></i>
                                <span>Editar</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@item.Id">
                                <i class="bi bi-info-circle text-warning"></i>
                                <span>Detalles</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Delete" asp-route-id="@item.Id">
                                <i class="bi bi-trash text-danger"></i>
                                <span>Borrar</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
