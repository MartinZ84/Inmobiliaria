@model IEnumerable<Inmobiliaria.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
    var Pagina = ViewBag.Pagina ?? 1;
    var TotalPaginas = ViewBag.TotalPaginas ?? 1;
}

<h1 class="mt-4">Listado de Usuarios</h1>
<hr />

@await Html.PartialAsync("_AutoDismissAlert")

<!-- Filtros y botón crear -->
<div class="row mb-3">
    <div class="col-md-10">
        <form method="get" asp-action="Index" id="formFiltros">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <button class="btn btn-link p-0 text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#filtrosCollapse" aria-expanded="false" aria-controls="filtrosCollapse">
                            <i class="bi bi-funnel me-2"></i>Filtros de búsqueda
                            <i class="bi bi-chevron-down ms-1"></i>
                        </button>
                    </h6>
                </div>
                <div class="collapse" id="filtrosCollapse">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="nombre" class="form-label">Nombre</label>
                                <input type="text" class="form-control" id="nombre" name="nombre" value="@ViewBag.Nombre" placeholder="Buscar por nombre">
                            </div>
                            <div class="col-md-3">
                                <label for="apellido" class="form-label">Apellido</label>
                                <input type="text" class="form-control" id="apellido" name="apellido" value="@ViewBag.Apellido" placeholder="Buscar por apellido">
                            </div>
                            <div class="col-md-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="text" class="form-control" id="email" name="email" value="@ViewBag.Email" placeholder="Buscar por email">
                            </div>
                            @* <div class="col-md-3">
                                <label for="rol" class="form-label">Rol</label>
                                <select class="form-select" id="rol" name="rol">
                                    <option value="">Todos</option>
                                    <option value="Administrador" @(ViewBag.Rol=="Administrador" ? "selected":"")>Administrador</option>
                                    <option value="SuperAdministrador" @(ViewBag.Rol=="SuperAdministrador" ? "selected":"")>SuperAdministrador</option>
                                    <option value="Empleado" @(ViewBag.Rol=="Empleado" ? "selected":"")>Empleado</option>
                                </select>
                            </div> *@
                        </div>
                        <div class="row mt-3">
                            <div class="col-12 d-flex align-items-center">
                                <button type="submit" class="btn btn-outline-primary me-2">
                                    <i class="bi bi-search me-1"></i>Buscar
                                </button>
                                <button type="button" class="btn btn-outline-secondary me-3" id="btnLimpiar">
                                    <i class="bi bi-eraser me-1"></i>Limpiar
                                </button>
                                <small class="text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Puede usar uno o varios criterios de búsqueda
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-md-2 d-flex align-items-start">
        <a asp-action="Create" class="btn btn-primary w-100">
            <i class="bi bi-plus-circle me-1"></i>Nuevo usuario
        </a>
    </div>
</div>

<!-- Tabla de resultados -->
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                <th>@Html.DisplayNameFor(model => model.Apellido)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>Avatar</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(m => item.Id)</td>
                        <td>@Html.DisplayFor(m => item.Nombre)</td>
                        <td>@Html.DisplayFor(m => item.Apellido)</td>
                        <td>@Html.DisplayFor(m => item.Email)</td>
                        <td class="text-center align-middle" style="display: flex; justify-content: center; align-items: center;">
    <img 
        src="@(String.IsNullOrEmpty(item.Avatar) ? 
               "https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y" 
               : item.Avatar)" 
        alt="Avatar" 
        class="rounded-circle border border-secondary" 
        style="width:40px; height:40px; object-fit:cover;" />
</td>
                        <td>@Html.DisplayFor(m => item.RolNombre)</td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="accionesMenu_@item.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="accionesMenu_@item.Id">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Edit" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil text-success"></i>Editar
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@item.Id">
                                            <i class="bi bi-info-circle text-warning"></i>Detalles
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Delete" asp-route-id="@item.Id">
                                            <i class="bi bi-trash text-danger"></i>Borrar
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="bi bi-search me-2"></i>No se encontraron usuarios con los criterios especificados.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Paginación -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-left">
            @if (Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="~/Usuarios/Index?pagina=@(Pagina - 1)&nombre=@ViewBag.Nombre&apellido=@ViewBag.Apellido&email=@ViewBag.Email&rol=@ViewBag.Rol">Anterior</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Anterior</span></li>
            }

            @for (int i = 1; i <= TotalPaginas; i++)
            {
                <li class="page-item @(i == Pagina ? "active" : "")">
                    <a class="page-link" href="~/Usuarios/Index?pagina=@i&nombre=@ViewBag.Nombre&apellido=@ViewBag.Apellido&email=@ViewBag.Email&rol=@ViewBag.Rol">@i</a>
                </li>
            }

            @if (Pagina < TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link" href="~/Usuarios/Index?pagina=@(Pagina + 1)&nombre=@ViewBag.Nombre&apellido=@ViewBag.Apellido&email=@ViewBag.Email&rol=@ViewBag.Rol">Siguiente</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Siguiente</span></li>
            }
        </ul>
    </nav>
</div>

<script>
$(document).ready(function() {
    // Limpiar filtros
    $('#btnLimpiar').click(function() {
        $('#nombre, #apellido, #email, #rol').val('');
    });

    // Mostrar filtros si hay criterios activos
    @if (!string.IsNullOrEmpty(ViewBag.Nombre?.ToString()) ||
         !string.IsNullOrEmpty(ViewBag.Apellido?.ToString()) ||
         !string.IsNullOrEmpty(ViewBag.Email?.ToString()) ||
         !string.IsNullOrEmpty(ViewBag.Rol?.ToString()))
    {
        <text>$('#filtrosCollapse').addClass('show');</text>
    }
});
</script>
