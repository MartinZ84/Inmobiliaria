@model Inmobiliaria.Models.Usuario
@{
    ViewData["Title"] = "Detalles del Usuario";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4 border-0">
                <!-- Header de la tarjeta -->
                <div class="card-header text-center text-white bg-primary rounded-top-4">
                    <h3 class="mb-0">Detalle del Usuario</h3>
                </div>

                <!-- Body -->
                <div class="card-body">
                    <div class="text-center mb-4">
                        <img src="@(Model.Avatar ?? "/img/default-avatar.png")" 
                             class="rounded-circle shadow-sm" 
                             style="width: 120px; height: 120px; object-fit: cover;" 
                             alt="Avatar de usuario" />
                        <h5 class="mt-3 fw-bold text-primary">@Model.Nombre @Model.Apellido</h5>
                        <p class="text-muted mb-0">@Model.Email</p>
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Rol:</strong>
                            <span class="badge bg-info text-dark">@Model.RolNombre</span>
                        </li>
                        @* <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Estado:</strong>
                            <span class="text-success">@((Model.Estado) ? "Activo" : "Inactivo")</span>
                        </li> *@
                        @* <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Fecha de Alta:</strong>
                            <span>@Model.FechaAlta.ToString("dd/MM/yyyy")</span>
                        </li>
                        @if (Model.FechaBaja.HasValue)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <strong>Fecha de Baja:</strong>
                                <span>@Model.FechaBaja.Value.ToString("dd/MM/yyyy")</span>
                            </li>
                        } *@
                    </ul>

                    <div class="mt-4 d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary w-45">
                            <i class="bi bi-pencil-fill me-1"></i> Editar
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary w-45">
                            <i class="bi bi-arrow-left-circle me-1"></i> Volver
                        </a>
                    </div>
                </div>

                <!-- Footer -->
                <div class="card-footer text-center bg-light rounded-bottom-4">
                    <small class="text-muted">Inmobiliaria Z&C Asociados</small>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
}
