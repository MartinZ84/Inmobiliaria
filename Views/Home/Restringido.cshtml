@{
    ViewData["Title"] = "Acceso restringido";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h1 class="display-4 text-danger">
                        <i class="bi bi-shield-lock-fill"></i> Acceso restringido
                    </h1>
                    <p class="lead mt-3">
                        Lo sentimos, no tiene permisos suficientes para acceder a este recurso.
                    </p>
                    <hr />
                    <p class="text-muted">
                        Si cree que esto es un error, por favor contacte con el administrador del sistema.
                    </p>
                    <a href="~/Home/Index" class="btn btn-primary mt-3">
                        <i class="bi bi-house-fill"></i> Volver al inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
