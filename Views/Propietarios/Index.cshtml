<!-- Tabla de resultados -->
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Id)</th>
                <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                <th>@Html.DisplayNameFor(model => model.Apellido)</th>
                <th>@Html.DisplayNameFor(model => model.Dni)</th>
                <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.Apellido)</td>
                        <td>@Html.DisplayFor(modelItem => item.Dni)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="accionesMenu_@item.Id" data-bs-toggle="dropdown" aria-expanded="false" title="Acciones">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="accionesMenu_@item.Id">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Edit" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil text-success"></i>
                                            <span>Editar</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@item.Id">
                                            <i class="bi bi-info-circle text-warning"></i>
                                            <span>Detalles</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Delete" asp-route-id="@item.Id">
                                            <i class="bi bi-trash text-danger"></i>
                                            <span>Borrar</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="bi bi-search me-2"></i>
                        @if (!string.IsNullOrEmpty(ViewBag.Dni?.ToString()) || 
                             !string.IsNullOrEmpty(ViewBag.Nombre?.ToString()) || 
                             !string.IsNullOrEmpty(ViewBag.Apellido?.ToString()) || 
                             !string.IsNullOrEmpty(ViewBag.Email?.ToString()))
                        {
                            <span>No se encontraron propietarios con los criterios especificados.</span>
                        }
                        else
                        {
                            <span>No hay propietarios registrados.</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
// Función de búsqueda AJAX (mantenida de tu código original)
function buscar(q) {
    return $.ajax({
        url: `@Url.Action("Buscar", "Propietarios")/${q}`,
        method: "GET"
    }).done(res => {
        console.log("Búsqueda: ", res);
    }).fail(res => {
        console.log("Error: ", res);
    });
}

// Funcionalidad adicional para los filtros
$(document).ready(function() {
    // Botón limpiar filtros
    $('#btnLimpiar').click(function() {
        $('#dni, #nombre, #apellido, #email').val('');
        @* window.location.href = '@Url.Action("Index", "Propietarios")'; *@
    });
    

    // Mostrar filtros si hay criterios de búsqueda activos
    @if (!string.IsNullOrEmpty(ViewBag.Dni?.ToString()) || 
         !string.IsNullOrEmpty(ViewBag.Nombre?.ToString()) || 
         !string.IsNullOrEmpty(ViewBag.Apellido?.ToString()) || 
         !string.IsNullOrEmpty(ViewBag.Email?.ToString()))
    {
        <text>
        $('#filtrosCollapse').addClass('show');
        </text>
    }

    // Búsqueda en tiempo real (opcional)
    let searchTimeout;
    $('#dni, #nombre, #apellido, #email').on('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function() {
            // Aquí podrías implementar búsqueda automática si lo deseas
            // $('#formFiltros').submit();
        }, 1000); // Espera 1 segundo después de dejar de escribir
    });

    // Resaltar campos con filtros activos
    $('#dni, #nombre, #apellido, #email').each(function() {
        if ($(this).val()) {
            $(this).addClass('border-primary');
        }
    });
});
</script>

