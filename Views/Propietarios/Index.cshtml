@model IEnumerable<Inmobiliaria.Models.Entidades.Propietario>

@{
    ViewData["Title"] = "Propietarios";
}

<h1 class="mt-4">Listado de Propietarios</h1>
<hr />

@await Html.PartialAsync("_AutoDismissAlert")

<!-- Sección de filtros y botón crear -->
<div class="row mb-3">
    <div class="col-md-10">
        <!-- Formulario de filtros -->
        <form method="get" asp-action="Index" id="formFiltros">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <button class="btn btn-link p-0 text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#filtrosCollapse" aria-expanded="false" aria-controls="filtrosCollapse">
                            <i class="bi bi-funnel me-2"></i>Filtros de búsqueda
                            <i class="bi bi-chevron-down ms-1"></i>
                        </button>
                    </h6>
                </div>
                <div class="collapse" id="filtrosCollapse">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="dni" class="form-label">DNI</label>
                                <input type="text" class="form-control" id="dni" name="dni" value="@ViewBag.Dni" placeholder="Buscar por DNI">
                            </div>
                            <div class="col-md-3">
                                <label for="nombre" class="form-label">Nombre</label>
                                <input type="text" class="form-control" id="nombre" name="nombre" value="@ViewBag.Nombre" placeholder="Buscar por nombre">
                            </div>
                            <div class="col-md-3">
                                <label for="apellido" class="form-label">Apellido</label>
                                <input type="text" class="form-control" id="apellido" name="apellido" value="@ViewBag.Apellido" placeholder="Buscar por apellido">
                            </div>
                            <div class="col-md-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="text" class="form-control" id="email" name="email" value="@ViewBag.Email" placeholder="Buscar por email">
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <button type="submit" class="btn btn-outline-primary me-2">
                                    <i class="bi bi-search me-1"></i>Buscar
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btnLimpiar">
                                    <i class="bi bi-eraser me-1"></i>Limpiar
                                </button>
                                <small class="text-muted ms-3">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Puede usar uno o varios criterios de búsqueda
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-md-2 d-flex align-items-start">
        <a asp-action="Create" class="btn btn-primary w-100">
            <i class="bi bi-plus-circle me-1"></i>Nuevo
        </a>
    </div>
</div>

<!-- Información de resultados -->
