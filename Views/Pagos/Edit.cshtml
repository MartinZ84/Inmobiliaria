@model Inmobiliaria.Models.Entidades.Pago

@{
    ViewData["Title"] = "Editar";
     var EstadosPago=ViewBag.EstadosPago;
}


<h4 class="mt-4"> Editar Pago del contrato N° @ViewBag.ContratoId</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" readonly/>
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NroPago" class="control-label"></label>
                <input asp-for="NroPago" class="form-control" readonly />
                <span asp-validation-for="NroPago" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaPago" class="control-label"></label>
                <input asp-for="FechaPago" class="form-control"  />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Importe" class="control-label"></label>
                <input asp-for="Importe" class="form-control" type="number" step="any"  />
                <span asp-validation-for="Importe" class="text-danger"></span>
            </div>
             <div class="form-group">
                <label asp-for="Concepto" class="control-label"></label>
                <input asp-for="Concepto" class="form-control" maxlength="500"/>
                <span asp-validation-for="Concepto" class="text-danger"></span>
            </div>
              <div class="form-group">
                <label asp-for="Estado" class="control-label"></label>
                <select asp-for="Estado"  class="form-select" asp-items="EstadosPago">
                </select>
            </div>
            <div class="form-group">
                <label asp-for="ContratoId" class="control-label"></label>
                <input asp-for="ContratoId" readonly class="form-control" readonly/>
                <span asp-validation-for="ContratoId" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" /> | @Html.ActionLink("Volver al listado", "Index", new { id = Model.ContratoId }, new{@class="btn btn-secondary"})
            </div>
        </form>
    </div>
</div>
<br>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
