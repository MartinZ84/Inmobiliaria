<script>
$(document).ready(function () {
    $("#revocarForm").on("submit", function (e) {
        let fechaInicio = new Date($("#fechaInicio").val());
        let fechaRevocacion = new Date($("#fechaFinAnt").val());

        if (fechaRevocacion <= fechaInicio) {
            e.preventDefault(); // bloquea envío del form
       
            $("#fechaFinAnt").addClass("is-invalid");
        } else {
            $("#fechaFinAnt").removeClass("is-invalid");
        }
    });
    // Quitar el error cuando el usuario cambia la fecha
    $("#fechaFinAnt").on("change input", function () {
        $(this).removeClass("is-invalid");
    });

});
</script>
