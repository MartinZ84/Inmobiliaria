@model Inmobiliaria.Models.ViewModels.ContratoRevocarViewModel

<h4 class="mt-4">Revocar Contrato</h4>
<small class="text-muted">
   <i class="bi bi-info-circle me-1"></i>
   Al revocar el contrato debera abonar una multa.Si se
cumplió menos de la mitad del tiempo original de alquiler, deberá
pagar 2 (dos) meses extra de alquiler de multa. Caso contrario, sólo uno.
</small>

<hr />

<form asp-action="RevocarConfirmar" method="post" id="revocarForm">
    <dl class="row">
        <dt class="col-sm-3">Inquilino</dt>
        <dd class="col-sm-9">@Model.InquilinoNombre</dd>

        <dt class="col-sm-3">Inmueble</dt>
        <dd class="col-sm-9">@Model.InmuebleDireccion</dd>

        <dt class="col-sm-3">Fecha Inicio</dt>
        <dd class="col-sm-9">@Model.FechaInicio.ToShortDateString()</dd>

        <dt class="col-sm-3">Fecha Fin Original</dt>
        <dd class="col-sm-9">@Model.FechaFin.ToShortDateString()</dd>

        <dt class="col-sm-3">Fecha Fin Anticipada</dt>
        <dd class="col-sm-9">@Model.FechaFinAnt?.ToShortDateString()</dd>

        <dt class="col-sm-3">Precio Mensual</dt>
        <dd class="col-sm-9">@Model.Precio.ToString("C")</dd>

        <dt class="col-sm-3">Meses cumplidos</dt>
        <dd class="col-sm-9">@Model.MesesCumplidos</dd>

        <dt class="col-sm-3">Multa a pagar</dt>
        <dd class="col-sm-9">@Model.Multa.ToString("C")</dd>

        <dt class="col-sm-3">Fecha Revocacion</dt>
        <dd class="col-sm-9">
            <div class="row">
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <input type="date" id="fechaFinAnt" name="fechaFinAnt"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="form-control" required />
                    <div class="invalid-feedback">
                        La fecha de revocación debe ser mayor a la fecha de inicio.
                    </div>
                </div>
            </div>
        </dd>

        <dt class="col-sm-3">Estado del pago</dt>
        <dd class="col-sm-9">
            <div class="row">
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <select asp-for="EstadoPago" asp-items="Model.EstadosPago" class="form-select"></select>
                </div>
            </div>
        </dd>
    </dl>

    <input type="hidden" id="fechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="multa" value="@Model.Multa" />

    <button type="submit" class="btn btn-danger">
        <i class="bi bi-dash-circle me-1"></i> Revocar Contrato
    </button>
    <a asp-action="Index" class="btn btn-secondary ms-2">
        <i class="bi bi-arrow-left me-1"></i> Volver al listado
    </a>
</form>


