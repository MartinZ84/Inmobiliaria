@model Inmobiliaria.Models.ViewModels.ContratoRevocarViewModel

<h1>Revocar Contrato</h1>
<hr />

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Inquilino</dt>
            <dd class="col-sm-9">@Model.InquilinoNombre</dd>

            <dt class="col-sm-3">Inmueble</dt>
            <dd class="col-sm-9">@Model.InmuebleDireccion</dd>

            <dt class="col-sm-3">Fecha Inicio</dt>
            <dd class="col-sm-9">@Model.FechaInicio.ToShortDateString()</dd>

            <dt class="col-sm-3">Fecha Fin Original</dt>
            <dd class="col-sm-9">@Model.FechaFin.ToShortDateString()</dd>

            <dt class="col-sm-3">Meses cumplidos</dt>
            <dd class="col-sm-9">@Model.MesesCumplidos</dd>

            <dt class="col-sm-3">Multa a pagar</dt>
            <dd class="col-sm-9">@Model.Multa.ToString("C")</dd>

            <dt class="col-sm-3">Estado del pago</dt>
            <dd class="col-sm-3">
                <select asp-for="EstadoPago" asp-items="Model.EstadosPago" class="form-select"></select>
            </dd>
        </dl>

        <form asp-action="RevocarConfirmar" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="multa" value="@Model.Multa" />

            <button type="submit" class="btn btn-danger">
                <i class="bi bi-dash-circle me-1"></i> Revocar Contrato
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
        </form>
    </div>
</div>
