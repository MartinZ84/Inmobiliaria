@using Inmobiliaria.Models.Entidades
@model Inmobiliaria.Models.Entidades.Contrato

@{
    ViewData["Title"] = "Nuevo contrato";

}



<h4 class="mt-4">Nuevo contrato</h4>
<hr />
@await Html.PartialAsync("_AutoDismissAlert")
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" id="formContrato">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @* <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="FechaInicio" class="control-label"></label>
           
                @* <input type="date" name="FechaInicio" id="fechaInicio" value="" 
                  min="" max="" class="form-control" /> *@
                   <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaFin" class="control-label"></label>
              
                 <input type="date" name="fechaFin" id="fechaFin" value="" class="form-control" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Precio" class="control-label"></label>
                <input asp-for="Precio" class="form-control" maxlength="10" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>
          <div class="form-group">
                <label asp-for="Estado" class="control-label"></label>
                <select class="form-select"  Disable name="Estado">
                  <option value="" disabled selected>Seleccionar estado  </option>
                  <option value="Vigente">Vigente</option>
            
                </select>

                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

           <div class="form-group">
               <label asp-for="InquilinoId" class="control-label"></label>
               <select asp-for="InquilinoId" class="form-select"
                       asp-items="@(new SelectList(ViewBag.Inquilinos ?? new List<object>(), "Id", "NombreCompleto", Model?.InquilinoId))">
                   <option value="">Seleccionar inquilino</option>
               </select>
               <span asp-validation-for="InquilinoId" class="text-danger"></span>
           </div>


            <div class="form-group">
            <label asp-for="InmuebleId" class="control-label"></label>
            <select asp-for="InmuebleId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Inmuebles ?? new List<object>(), "Id", "Direccion", Model?.InmuebleId))">
                <option value="">Seleccionar inmueble</option>
            </select>
            <span asp-validation-for="InmuebleId" class="text-danger"></span>
            </div>

<br>
          
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" /> |
                 <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </form>
    </div>
</div>
<br>

<script>
  

window.onload = function () {
  var fecha = new Date(); //Fecha actual
  var mes = fecha.getMonth() + 1; //obteniendo mes
  var dia = fecha.getDate(); //obteniendo dia
  var ano = fecha.getFullYear(); //obteniendo año
  if (dia < 10) dia = "0" + dia; //agrega cero si el menor de 10
  if (mes < 10) mes = "0" + mes; //agrega cero si el menor de 10
  document.getElementById("fechaInicio").value = ano + "-" + mes + "-" + dia;
//  document.getElementById("fechaInicio").min = ano + "-" + mes + "-" + dia;

  //sumar 2 años a la fecha actual
  var fecha2 = new Date(); //Fecha actual
  var mes2 = fecha2.getMonth() + 1; //obteniendo mes
  var dia2 = fecha2.getDate(); //obteniendo dia
  var ano2 = fecha2.getFullYear() + 2; //obteniendo año
  if (dia2 < 10) dia2 = "0" + dia2; //agrega cero si el menor de 10
  if (mes2 < 10) mes2 = "0" + mes2; //agrega cero si el menor de 10
  document.getElementById("fechaFin").value = ano2 + "-" + mes2 + "-" + dia2;
  // document.getElementById("fechaFin").max = ano2 + "-" + mes2 + "-" + dia2;
   //  document.getElementById("fechaFin").min =  ano + "-" + mes + "-" + dia;
};

  $(document).ready(function () {
            // -------------------------------
            // 1. Validar InquilinoId > 0
            // -------------------------------
            $("#InquilinoId").on("change", function () {
                validarInquilino();
            });

            function validarInquilino() {
                let valor = $("#InquilinoId").val();
                if (!valor || valor == "0") {
                    mostrarError("#InquilinoId", "Debe seleccionar un inquilino");
                    return false;
                } else {
                    limpiarError("#InquilinoId");
                    return true;
                }
            }

            // -------------------------------
            // 2. Validar InmuebleId > 0
            // -------------------------------
            $("#InmuebleId").on("change", function () {
                validarInmueble();
            });

            function validarInmueble() {
                let valor = $("#InmuebleId").val();
                if (!valor || valor == "0") {
                    mostrarError("#InmuebleId", "Debe seleccionar un inmueble");
                    return false;
                } else {
                    limpiarError("#InmuebleId");
                    return true;
                }
            }

            // -------------------------------
            // 3. Validar fechaInicio >= hoy
            // -------------------------------
            $("#fechaInicio").on("change", function () {
                validarFechaInicio();
            });

            function validarFechaInicio() {
                let valor = $("#fechaInicio").val();
                if (!valor) return false;

                let hoy = new Date().toISOString().split("T")[0]; // fecha de hoy en formato "2025-09-02"
                
                if (valor < hoy) {
                    mostrarError("#fechaInicio", "La fecha de inicio no puede ser menor a hoy");
                    return false;
                } else {
                    limpiarError("#fechaInicio");
                    return true;
                }
            }

            // -------------------------------
            // 4. Validar fechaFin > fechaInicio
            // -------------------------------
            $("#fechaFin").on("change", function () {
                validarFechaFin();
            });

            function validarFechaFin() {
                let inicio = $("#fechaInicio").val();
                let fin = $("#fechaFin").val();
                if (!inicio || !fin) return false;

                let fechaInicio = new Date(inicio);
                let fechaFin = new Date(fin);

                if (fechaFin <= fechaInicio) {
                    mostrarError("#fechaFin", "La fecha de fin debe ser mayor a la fecha de inicio");
                    return false;
                } else {
                    limpiarError("#fechaFin");
                    return true;
                }
            }

            // -------------------------------
            // Validación antes de enviar
            // -------------------------------
            $("#formContrato").on("submit", function (e) {
                let okInquilino = validarInquilino();
                let okInmueble = validarInmueble();
                let okInicio = validarFechaInicio();
                let okFin = validarFechaFin();

                if (!(okInquilino && okInmueble && okInicio && okFin)) {
                    e.preventDefault(); // detener submit
                }
            });

            // -------------------------------
            // Helpers para mensajes de error
            // -------------------------------
            function mostrarError(selector, mensaje) {
                let span = $(selector).closest(".form-group").find(".text-danger");
                span.text(mensaje);
            }

            function limpiarError(selector) {
                let span = $(selector).closest(".form-group").find(".text-danger");
                span.text("");
            }
        });


</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

